<?xml version="1.0" encoding="utf-8"?>
<!-- Zastava (be): tri uspravne pruge -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="60dp" android:height="42dp">
        <shape><solid android:color="#FDDA24" /><corners android:radius="5dp" /></shape>
    </item>
    <item android:width="20dp" android:height="42dp" android:gravity="left">
        <shape><solid android:color="#000000" /><corners android:topLeftRadius="5dp" android:bottomLeftRadius="5dp" /></shape>
    </item>
    <item android:width="20dp" android:height="42dp" android:gravity="right">
        <shape><solid android:color="#EF3340" /><corners android:topRightRadius="5dp" android:bottomRightRadius="5dp" /></shape>
    </item>
    <item android:width="60dp" android:height="42dp">
        <shape><stroke android:width="1dp" android:color="#33000000" /><corners android:radius="5dp" /></shape>
    </item>
</layer-list>
