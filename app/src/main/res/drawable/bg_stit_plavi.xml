<?xml version="1.0" encoding="utf-8"?>
<!-- Štit autoputa: plavo polje sa belim okvirom (Belgija, Luksemburg) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/stit_plavi" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</layer-list>
