<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/koren"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pozadina_liste"
    android:orientation="vertical"
    tools:context=".DetaljiActivity">

    <!-- Plavo zaglavlje: nazad, štit autoputa, naziv i vrsta mesta -->
    <LinearLayout
        android:id="@+id/zaglavlje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/plava"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/nazad"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_okrugli_taster"
            android:contentDescription="@string/nazad"
            android:src="@drawable/ic_nazad" />

        <TextView
            android:id="@+id/stit"
            style="@style/Stit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_stit"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textSize="18sp"
            tools:text="A 2" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/naziv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                tools:text="Berchem-Ouest" />

            <TextView
                android:id="@+id/opis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/plava_svetla"
                android:textSize="13sp"
                tools:text="Odmorište" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/sadrzaj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp" />
    </ScrollView>

    <!-- Dugmad na dnu -->
    <LinearLayout
        android:id="@+id/dugmad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/povrsina"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navigacija"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/plava"
            android:text="@string/det_navigacija"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/podeli"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/cip_obicno"
            android:contentDescription="@string/det_podeli"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="56dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_podeli"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/cip_obicno_tekst" />
    </LinearLayout>
</LinearLayout>
