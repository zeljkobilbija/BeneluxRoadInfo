<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/koren"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pozadina_liste"
    android:orientation="vertical"
    tools:context=".StanjeActivity">

    <!-- Plavo zaglavlje -->
    <LinearLayout
        android:id="@+id/zaglavlje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/plava"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp">

        <ImageButton
            android:id="@+id/nazad"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_okrugli_taster"
            android:contentDescription="@string/nazad"
            android:src="@drawable/ic_nazad" />

        <TextView
            android:id="@+id/stit"
            style="@style/Stit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_stit"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:textSize="26sp"
            tools:text="A 8" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/stanje_naslov"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/podnaslov"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/plava_svetla"
                android:textSize="13sp"
                tools:text="Updated at 09:40" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/osvezi"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_okrugli_taster"
            android:contentDescription="@string/stanje_osvezi"
            android:src="@drawable/ic_osvezi" />
    </LinearLayout>

    <!-- Obaveštenja za ovaj autoput -->
    <LinearLayout
        android:id="@+id/redObavestenja"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/povrsina"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stanje_obavestenja"
                android:textColor="@color/tekst"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/obavestenjaOpis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/tekst_sekundarni"
                android:textSize="13sp"
                tools:text="Accidents, queues and closures on A 8 – checked about every 20 minutes" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/prekidac"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/linija" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/poruka"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:textColor="@color/tekst_sekundarni"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/povrsina"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:text="@string/stanje_izvor"
        android:textColor="@color/tekst_sekundarni"
        android:textSize="11sp" />

    <FrameLayout
        android:id="@+id/reklamaKontejner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
