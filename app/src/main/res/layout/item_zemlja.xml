<?xml version="1.0" encoding="utf-8"?>
<!-- Kartica zemlje na početnom ekranu -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:stateListAnimator="@animator/kartica_pritisak"
    app:cardBackgroundColor="@color/povrsina"
    app:cardCornerRadius="22dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="110dp"
        android:orientation="horizontal"
        android:padding="20dp">

        <ImageView
            android:id="@+id/zastava"
            android:layout_width="72dp"
            android:layout_height="50dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            tools:src="@drawable/zastava_nl" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/imeZemlje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:textColor="@color/tekst"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="Nederland" />

            <TextView
                android:id="@+id/brojAutoputeva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/plava_tekst"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Motorways · 30" />
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:rotation="180"
            android:src="@drawable/ic_nazad"
            app:tint="@color/tekst_sekundarni" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
