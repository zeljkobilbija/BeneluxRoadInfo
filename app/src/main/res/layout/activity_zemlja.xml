<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pozadina"
    android:orientation="vertical"
    tools:context=".ZemljaActivity">

    <!-- Naslov -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="16dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/nazad"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="-8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nazad"
            android:src="@drawable/ic_nazad"
            app:tint="@color/tekst" />

        <ImageView
            android:id="@+id/zastava"
            android:layout_width="36dp"
            android:layout_height="25dp"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            tools:src="@drawable/zastava_nl" />

        <TextView
            android:id="@+id/imeZemlje"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:maxLines="1"
            android:textColor="@color/tekst"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="Nederland" />

        <ImageButton
            android:id="@+id/dugmePodeli"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/podeli"
            android:src="@drawable/ic_podeli"
            app:tint="@color/tekst_sekundarni" />

        <ImageButton
            android:id="@+id/dugmePrivatnosti"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/privatnost"
            android:src="@drawable/ic_privatnost"
            android:visibility="gone"
            app:tint="@color/tekst_sekundarni" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:text="@string/podnaslov"
        android:textColor="@color/tekst_sekundarni"
        android:textSize="15sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaAutoputeva"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/layout_ulaz"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="16dp" />

    <!-- Mesto za AdMob baner -->
    <FrameLayout
        android:id="@+id/reklamaKontejner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="0dp" />
</LinearLayout>
