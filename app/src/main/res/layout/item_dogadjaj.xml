<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/vrsta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Accident" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/kasnjenje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/kasnjenje"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="+11 min" />
    </LinearLayout>

    <TextView
        android:id="@+id/deonica"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/tekst"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Idstein – Wiesbadener Kreuz" />

    <TextView
        android:id="@+id/smer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/tekst"
        android:textSize="14sp"
        tools:text="Köln → Frankfurt" />

    <TextView
        android:id="@+id/vreme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/tekst_sekundarni"
        android:textSize="12sp"
        tools:text="since 17 Nov, 09:16" />

    <TextView
        android:id="@+id/opis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/pozadina_liste"
        android:padding="10dp"
        android:textColor="@color/tekst_sekundarni"
        android:textIsSelectable="false"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/karta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackground"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/stanje_na_mapi"
        android:textColor="@color/plava_tekst"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
